#!/bin/sh
# Scheduler-neutral job template. Fill it in by hand, or have the assistant fill it.
# The shebang must stay on the first line: SLURM rejects a batch script without one.
#
# Keep the directive block for YOUR scheduler and delete the others. Only the SLURM
# block is live as shipped. The PBS and SGE lines are switched off with a doubled
# '#': if you keep one of those blocks, change '##PBS' to '#PBS' or '##$' to '#$',
# or the scheduler will ignore them and run the job with its defaults.
# If you have no scheduler, delete all three blocks and run it as a plain shell script.

# --- SLURM -------------------------------------------------------------------
#SBATCH --job-name={{JOB_NAME}}
#SBATCH --account={{ACCOUNT}}
#SBATCH --partition={{QUEUE}}
#SBATCH --cpus-per-task={{THREADS}}
#SBATCH --mem={{MEMORY}}
#SBATCH --time={{WALLTIME}}
#SBATCH --output={{LOGDIR}}/{{JOB_NAME}}.%j.out

# --- PBS / Torque ------------------------------------------------------------
##PBS -N {{JOB_NAME}}
##PBS -P {{ACCOUNT}}
##PBS -q {{QUEUE}}
##PBS -l select=1:ncpus={{THREADS}}:mem={{MEMORY}}
##PBS -l walltime={{WALLTIME}}
##PBS -o {{LOGDIR}}/{{JOB_NAME}}.out

# --- SGE ---------------------------------------------------------------------
##$ -N {{JOB_NAME}}
##$ -pe smp {{THREADS}}
##$ -l h_rt={{WALLTIME}}
##$ -o {{LOGDIR}}/{{JOB_NAME}}.out

set -eu
cd "{{WORKDIR}}"
{{ENV_ACTIVATE}}
sh src/steps/{{STEP}} {{CONFIG}}
