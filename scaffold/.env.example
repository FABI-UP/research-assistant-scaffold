# Copy to .env and fill in. .env is gitignored and must never be committed.
# Keep this example in sync with .env — it is the only record of what the project needs.

# --- Compute -----------------------------------------------------------------
# Leave blank if everything runs locally.
COMPUTE_HOST=
COMPUTE_USER=
COMPUTE_ACCOUNT=
COMPUTE_WORKDIR=
COMPUTE_QUEUE=

# --- Experiment tracking (optional) ------------------------------------------
# Any tracker, or none. Nothing in the scaffold reads these yet; they reserve the
# names. A tracker you wire in must treat them as optional and say in the log when
# it is not recording — tracking must never be able to stop a pipeline.
TRACKER_API_KEY=
TRACKER_ENTITY=
TRACKER_PROJECT=

# --- External services (optional) --------------------------------------------
# One line per service the assistant is allowed to reach. If it is not listed
# here, the assistant should report that it cannot reach it rather than improvise.
